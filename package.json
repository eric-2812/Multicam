{
  "name": "cortiva",
  "productName": "Cortiva",
  "description": "Multicam recording and control: record every camera and mic in sync.",
  "author": "Cortiva",
  "license": "GPL-3.0-or-later",
  "private": true,
  "version": "0.16.0-beta",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "animejs": "4.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lightningcss": "1.33.0",
    "motion": "14.14.0",
    "number-flow": "0.6.2",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.cortiva.multicam",
    "productName": "Cortiva",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/index.html",
      "!dist/kit/**",
      "!dist/assets/home-*",
      "!dist/assets/sections-*",
      "electron/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cortiva-Setup-${version}.exe",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "Cortiva-${version}-portable.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eric-2812",
        "repo": "cortiva",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eric-2812/cortiva.git"
  },
  "homepage": "https://eric-2812.github.io/cortiva/",
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
